{
  "manifest_version": 2,
  "name": "Darkberry Wisp",
  "version": "0.3.0",
  "description": "Darkberry for Thunderbird. Light. A pale page, the berries deepened to read on it. The light theme that doesn't hurt.",
  "homepage_url": "https://darkberry.slacklab.ca",
  "browser_specific_settings": {
    "gecko": {
      "id": "darkberry-wisp-thunderbird@darkberry-theme",
      "strict_min_version": "128.0"
    }
  },
  "theme_experiment": {
    "stylesheet": "theme.css",
    "colors": {
      "spaces_bg": "--spaces-bg-color",
      "spaces_button_active_bg": "--spaces-button-active-bg-color",
      "spaces_button_active_text": "--spaces-button-active-text-color",
      "tabs_toolbar_bg": "--tabs-toolbar-background-color",
      "layout_background_0": "--layout-background-0",
      "layout_background_1": "--layout-background-1",
      "layout_background_2": "--layout-background-2",
      "layout_background_3": "--layout-background-3",
      "layout_background_4": "--layout-background-4",
      "layout_color_0": "--layout-color-0",
      "layout_color_1": "--layout-color-1",
      "layout_color_2": "--layout-color-2",
      "layout_color_3": "--layout-color-3",
      "layout_border_0": "--layout-border-0",
      "layout_border_1": "--layout-border-1",
      "layout_border_2": "--layout-border-2",
      "tree_view_bg": "--tree-view-bg",
      "tree_pane_bg": "--tree-pane-background",
      "tree_card_bg": "--tree-card-background",
      "button_bg": "--button-background-color",
      "calendar_view_toggle_bg": "--calendar-view-toggle-background",
      "calendar_view_toggle_hover_bg": "--calendar-view-toggle-hover-background",
      "calendar_today_bg": "--viewTodayBackground",
      "calendar_weekend_bg": "--viewWeekendBackground",
      "calendar_today_weekend_bg": "--viewTodayWeekendBackground",
      "calendar_week_label_bg": "--viewMonthWeekLabelBackground",
      "calendar_day_label_selected_bg": "--viewDayLabelSelectedBackground",
      "calendar_day_label_selected_text": "--viewDayLabelSelectedColor",
      "calendar_dragbox_bg": "--viewDragboxBackground",
      "calendar_dropshadow_bg": "--viewDropshadowBackground",
      "unread_color": "--unread-color",
      "new_subject_color": "--new-subject-color",
      "new_color": "--new-color",
      "link_color": "--link-color",
      "darkberry_accent_text": "--darkberry-accent-text",
      "folder_unread_count_bg": "--folderpane-unread-count-background",
      "folder_unread_new_count_bg": "--folderpane-unread-new-count-background",
      "folder_unread_count_text": "--folderpane-unread-count-text",
      "folder_total_count_bg": "--folderpane-total-count-background",
      "folder_total_count_text": "--folderpane-total-count-text",
      "color_gray_70": "--color-gray-70",
      "color_gray_50": "--color-gray-50"
    }
  },
  "theme": {
    "colors": {
      "frame": "#ebdae5",
      "frame_inactive": "#ebdae5",
      "tab_selected": "#fbf4f8",
      "tab_text": "#4f3143",
      "tab_background_text": "#694e5f",
      "tab_background_separator": "#d0bac8",
      "tab_line": "#d21570",
      "tab_loading": "#b9488b",
      "toolbar": "#fbf4f8",
      "toolbar_text": "#4f3143",
      "bookmark_text": "#4f3143",
      "icons": "#694e5f",
      "icons_attention": "#b9488b",
      "toolbar_field": "#dfcbd8",
      "toolbar_field_text": "#4f3143",
      "toolbar_field_border": "#d0bac8",
      "toolbar_field_separator": "#d0bac8",
      "toolbar_field_focus": "#dfcbd8",
      "toolbar_field_text_focus": "#4f3143",
      "toolbar_field_border_focus": "#9e5e70",
      "toolbar_field_highlight": "#f0cadd",
      "toolbar_field_highlight_text": "#4f3143",
      "toolbar_top_separator": "#ebdae5",
      "toolbar_bottom_separator": "#dfcbd8",
      "toolbar_vertical_separator": "#d0bac8",
      "popup": "#f3e6ef",
      "popup_text": "#4f3143",
      "popup_border": "#d0bac8",
      "popup_highlight": "#b9488b",
      "popup_highlight_text": "#ffffff",
      "sidebar": "#f3e6ef",
      "sidebar_text": "#4f3143",
      "sidebar_border": "#d0bac8",
      "sidebar_highlight": "#b9488b",
      "sidebar_highlight_text": "#ffffff",
      "sidebar_highlight_border": "#b9488b",
      "button_background_hover": "#dfcbd8",
      "button_background_active": "#d0bac8",
      "spaces_bg": "#ebdae5",
      "spaces_button_active_bg": "#b9488b",
      "spaces_button_active_text": "#ffffff",
      "tabs_toolbar_bg": "#ebdae5",
      "layout_background_0": "#fbf4f8",
      "layout_background_1": "#f3e6ef",
      "layout_background_2": "#dfcbd8",
      "layout_background_3": "#d0bac8",
      "layout_background_4": "#c3abb9",
      "layout_color_0": "#4f3143",
      "layout_color_1": "#4f3143",
      "layout_color_2": "#694e5f",
      "layout_color_3": "#967d8c",
      "layout_border_0": "#d0bac8",
      "layout_border_1": "#c3abb9",
      "layout_border_2": "#ac93a2",
      "tree_view_bg": "#fbf4f8",
      "tree_pane_bg": "#f3e6ef",
      "tree_card_bg": "#fbf4f8",
      "button_bg": "#dfcbd8",
      "calendar_view_toggle_bg": "#dfcbd8",
      "calendar_view_toggle_hover_bg": "#d0bac8",
      "calendar_today_bg": "#dfcbd8",
      "calendar_weekend_bg": "#ebdae5",
      "calendar_today_weekend_bg": "#dfcbd8",
      "calendar_week_label_bg": "#d0bac8",
      "calendar_day_label_selected_bg": "#b9488b",
      "calendar_day_label_selected_text": "#ffffff",
      "calendar_dragbox_bg": "#f0cadd",
      "calendar_dropshadow_bg": "#f0cadd",
      "unread_color": "#4f3143",
      "new_subject_color": "#4f3143",
      "new_color": "#d21570",
      "link_color": "#026b80",
      "darkberry_accent_text": "#d21570",
      "folder_unread_count_bg": "#b9488b",
      "folder_unread_new_count_bg": "#b9488b",
      "folder_unread_count_text": "#ffffff",
      "folder_total_count_bg": "#d0bac8",
      "folder_total_count_text": "#4f3143",
      "color_gray_70": "#f3e6ef",
      "color_gray_50": "#d0bac8"
    },
    "properties": {
      "color_scheme": "light",
      "content_color_scheme": "light"
    }
  }
}
