      "tree_view_bg": "#2a1e26",
      "tree_pane_bg": "#23161f",
      "tree_card_bg": "#2a1e26",
      "button_bg": "#32222c",
      "calendar_view_toggle_bg": "#32222c",
      "calendar_view_toggle_hover_bg": "#3e2936",
      "calendar_today_bg": "#32222c",
      "calendar_weekend_bg": "#1c1119",
      "calendar_today_weekend_bg": "#32222c",
      "calendar_week_label_bg": "#3e2936",
      "calendar_day_label_selected_bg": "#be4c8d",
      "calendar_day_label_selected_text": "#ffffff",
      "calendar_dragbox_bg": "#502f3d",
      "calendar_dropshadow_bg": "#502f3d",
      "unread_color": "#efe3eb",
      "new_subject_color": "#efe3eb",
      "new_color": "#fd7ca5",
      "link_color": "#86c0cc",
      "darkberry_accent_text": "#fd7ca5",
      "folder_unread_count_bg": "#be4c8d",
      "folder_unread_new_count_bg": "#be4c8d",
      "folder_unread_count_text": "#ffffff",
      "folder_total_count_bg": "#3e2936",
      "folder_total_count_text": "#efe3eb",
      "color_gray_70": "#23161f",
      "color_gray_50": "#3e2936"
