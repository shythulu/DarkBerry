      "popup": "#e3eafb",
      "popup_text": "#2f3b58",
      "popup_border": "#b9c1d5",
      "popup_highlight": "#b9488b",
      "popup_highlight_text": "#ffffff",
      "sidebar": "#e3eafb",
      "sidebar_text": "#2f3b58",
      "sidebar_border": "#b9c1d5",
      "sidebar_highlight": "#b9488b",
      "sidebar_highlight_text": "#ffffff",
      "sidebar_highlight_border": "#b9488b",
      "button_background_hover": "#c9d2e5",
      "button_background_active": "#b9c1d5",
      "lwt_frame": "#d8e0f2",
      "spaces_bg": "#d8e0f2",
      "spaces_button_active_bg": "#b9488b",
      "spaces_button_active_text": "#ffffff",
      "tabs_toolbar_bg": "#d8e0f2",
      "layout_background_0": "#f2f6ff",
      "layout_background_1": "#e3eafb",
      "layout_background_2": "#c9d2e5",
      "layout_background_3": "#b9c1d5",
      "layout_background_4": "#aab3c7",
      "layout_color_0": "#2f3b58",
      "layout_color_1": "#2f3b58",
      "layout_color_2": "#4a5774",
      "layout_color_3": "#7a859f",
      "layout_border_0": "#b9c1d5",
      "layout_border_1": "#aab3c7",
      "layout_border_2": "#909bb6",
      "tree_view_bg": "#f2f6ff",
      "tree_pane_bg": "#e3eafb",
      "tree_card_bg": "#f2f6ff",
      "button_bg": "#c9d2e5",
      "calendar_view_toggle_bg": "#c9d2e5",
      "calendar_view_toggle_hover_bg": "#b9c1d5",
      "calendar_today_bg": "#c9d2e5",
      "calendar_weekend_bg": "#d8e0f2",
      "calendar_today_weekend_bg": "#c9d2e5",
      "calendar_week_label_bg": "#b9c1d5",
      "calendar_day_label_selected_bg": "#b9488b",
      "calendar_day_label_selected_text": "#ffffff",
      "calendar_dragbox_bg": "#e9cce3",
      "calendar_dropshadow_bg": "#e9cce3",
      "unread_color": "#2f3b58",
      "new_subject_color": "#2f3b58",
      "new_color": "#335adf",
      "link_color": "#026b80",
      "darkberry_accent_text": "#335adf",
      "folder_unread_count_bg": "#b9488b",
      "folder_unread_new_count_bg": "#b9488b",
      "folder_unread_count_text": "#ffffff",
      "folder_total_count_bg": "#b9c1d5",
      "folder_total_count_text": "#2f3b58",
      "color_gray_70": "#e3eafb",
      "color_gray_50": "#b9c1d5"
    },
    "properties": {
      "color_scheme": "light",
      "content_color_scheme": "light"
    }
  }
}
