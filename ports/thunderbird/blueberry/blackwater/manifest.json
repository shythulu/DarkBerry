      "tree_view_bg": "#0d1529",
      "tree_pane_bg": "#080f23",
      "tree_card_bg": "#0d1529",
      "button_bg": "#151e33",
      "calendar_view_toggle_bg": "#151e33",
      "calendar_view_toggle_hover_bg": "#1e2840",
      "calendar_today_bg": "#151e33",
      "calendar_weekend_bg": "#050b1e",
      "calendar_today_weekend_bg": "#151e33",
      "calendar_week_label_bg": "#1e2840",
      "calendar_day_label_selected_bg": "#ba4889",
      "calendar_day_label_selected_text": "#ffffff",
      "calendar_dragbox_bg": "#38283f",
      "calendar_dropshadow_bg": "#38283f",
      "unread_color": "#dee5f4",
