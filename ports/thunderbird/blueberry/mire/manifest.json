      "popup_text": "#e0e7f6",
      "popup_border": "#253049",
      "popup_highlight": "#be4c8d",
      "popup_highlight_text": "#ffffff",
      "sidebar": "#111a2f",
      "sidebar_text": "#e0e7f6",
      "sidebar_border": "#253049",
      "sidebar_highlight": "#be4c8d",
      "sidebar_highlight_text": "#ffffff",
      "sidebar_highlight_border": "#be4c8d",
      "button_background_hover": "#1d273e",
      "button_background_active": "#253049",
      "spaces_bg": "#0c1428",
      "spaces_button_active_bg": "#be4c8d",
      "spaces_button_active_text": "#ffffff",
      "tabs_toolbar_bg": "#0c1428",
      "layout_background_0": "#192237",
      "layout_background_1": "#111a2f",
      "layout_background_2": "#1d273e",
      "layout_background_3": "#253049",
      "layout_background_4": "#2f3b58",
      "layout_color_0": "#e0e7f6",
      "layout_color_1": "#e0e7f6",
      "layout_color_2": "#bac1d0",
      "layout_color_3": "#7d879d",
      "layout_border_0": "#253049",
      "layout_border_1": "#2f3b58",
      "layout_border_2": "#657087",
      "tree_view_bg": "#192237",
      "tree_pane_bg": "#111a2f",
      "tree_card_bg": "#192237",
      "button_bg": "#1d273e",
      "calendar_view_toggle_bg": "#1d273e",
      "calendar_view_toggle_hover_bg": "#253049",
      "calendar_today_bg": "#1d273e",
      "calendar_weekend_bg": "#0c1428",
      "calendar_today_weekend_bg": "#1d273e",
      "calendar_week_label_bg": "#253049",
      "calendar_day_label_selected_bg": "#be4c8d",
      "calendar_day_label_selected_text": "#ffffff",
      "calendar_dragbox_bg": "#42324b",
      "calendar_dropshadow_bg": "#42324b",
      "unread_color": "#e0e7f6",
      "new_subject_color": "#e0e7f6",
      "new_color": "#87aafd",
      "link_color": "#86c0cc",
      "darkberry_accent_text": "#87aafd",
      "folder_unread_count_bg": "#be4c8d",
      "folder_unread_new_count_bg": "#be4c8d",
      "folder_unread_count_text": "#ffffff",
      "folder_total_count_bg": "#253049",
      "folder_total_count_text": "#e0e7f6",
      "color_gray_70": "#111a2f",
      "color_gray_50": "#253049"
    },
    "properties": {
      "color_scheme": "dark",
      "content_color_scheme": "dark"
    }
  }
}
