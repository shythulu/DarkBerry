      "layout_border_1": "#576585",
      "layout_border_2": "#6d7996",
      "tree_view_bg": "#2f3b58",
      "tree_pane_bg": "#25304b",
      "tree_card_bg": "#2f3b58",
      "button_bg": "#3c4967",
      "calendar_view_toggle_bg": "#3c4967",
      "calendar_view_toggle_hover_bg": "#4a5776",
      "calendar_today_bg": "#3c4967",
      "calendar_weekend_bg": "#1d2740",
      "calendar_today_weekend_bg": "#3c4967",
      "calendar_week_label_bg": "#4a5776",
      "calendar_day_label_selected_bg": "#dc67a7",
      "calendar_day_label_selected_text": "#1d2740",
      "calendar_dragbox_bg": "#544b69",
      "calendar_dropshadow_bg": "#544b69",
      "unread_color": "#e3eaf9",
