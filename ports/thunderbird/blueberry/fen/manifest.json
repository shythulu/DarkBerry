      "new_color": "#9bb9ff",
      "link_color": "#83d4db",
      "darkberry_accent_text": "#9bb9ff",
      "folder_unread_count_bg": "#dc67a7",
      "folder_unread_new_count_bg": "#dc67a7",
      "folder_unread_count_text": "#1d2740",
      "folder_total_count_bg": "#4a5776",
      "folder_total_count_text": "#e3eaf9",
      "color_gray_70": "#25304b",
      "color_gray_50": "#4a5776"
