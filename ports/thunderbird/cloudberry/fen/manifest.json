{
  "manifest_version": 2,
  "name": "Cloudberry Fen",
  "version": "0.3.0",
  "description": "Cloudberry for Thunderbird. Soft dark. The gentlest dark flavour, a shade above Mire. Backgrounds warmed toward ripe peach.",
  "homepage_url": "https://darkberry.slacklab.ca",
