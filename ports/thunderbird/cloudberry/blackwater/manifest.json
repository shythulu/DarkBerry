      "tree_view_bg": "#261207",
      "tree_pane_bg": "#1f0d04",
      "tree_card_bg": "#261207",
      "button_bg": "#301a0e",
      "calendar_view_toggle_bg": "#301a0e",
      "calendar_view_toggle_hover_bg": "#3c2416",
      "calendar_today_bg": "#301a0e",
      "calendar_weekend_bg": "#1a0802",
      "calendar_today_weekend_bg": "#301a0e",
      "calendar_week_label_bg": "#3c2416",
      "calendar_day_label_selected_bg": "#ba4889",
