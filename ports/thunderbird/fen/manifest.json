      "layout_border_2": "#8f6e82",
      "tree_view_bg": "#4f3143",
      "tree_pane_bg": "#402838",
      "tree_card_bg": "#4f3143",
      "button_bg": "#5d3e51",
      "calendar_view_toggle_bg": "#5d3e51",
      "calendar_view_toggle_hover_bg": "#6c4c60",
      "calendar_today_bg": "#5d3e51",
      "calendar_weekend_bg": "#35212e",
      "calendar_today_weekend_bg": "#5d3e51",
      "calendar_week_label_bg": "#6c4c60",
      "calendar_day_label_selected_bg": "#dc67a7",
      "calendar_day_label_selected_text": "#35212e",
      "calendar_dragbox_bg": "#6e4457",
      "calendar_dropshadow_bg": "#6e4457",
