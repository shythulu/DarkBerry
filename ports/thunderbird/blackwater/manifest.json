{
  "manifest_version": 2,
  "name": "Darkberry Blackwater",
  "version": "0.3.0",
  "description": "Darkberry for Thunderbird. Darkest. Deeper surfaces, the same berries as Mire. Blood in bog water.",
  "homepage_url": "https://darkberry.slacklab.ca",
  "browser_specific_settings": {
    "gecko": {
      "id": "darkberry-blackwater-thunderbird@darkberry-theme",
      "strict_min_version": "128.0"
    }
  },
  "theme_experiment": {
    "stylesheet": "theme.css",
    "colors": {
