      "button_bg": "#271a23",
      "calendar_view_toggle_bg": "#271a23",
      "calendar_view_toggle_hover_bg": "#34222e",
      "calendar_today_bg": "#271a23",
      "calendar_weekend_bg": "#12090f",
      "calendar_today_weekend_bg": "#271a23",
      "calendar_week_label_bg": "#34222e",
      "calendar_day_label_selected_bg": "#ba4889",
      "calendar_day_label_selected_text": "#ffffff",
      "calendar_dragbox_bg": "#452533",
      "calendar_dropshadow_bg": "#452533",
