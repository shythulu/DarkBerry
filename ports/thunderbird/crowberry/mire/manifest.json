      "sidebar_border": "#342b45",
      "sidebar_highlight": "#be4c8d",
      "sidebar_highlight_text": "#ffffff",
      "sidebar_highlight_border": "#be4c8d",
      "button_background_hover": "#2b233b",
      "button_background_active": "#342b45",
      "spaces_bg": "#181025",
      "spaces_button_active_bg": "#be4c8d",
      "spaces_button_active_text": "#ffffff",
      "tabs_toolbar_bg": "#181025",
      "layout_background_0": "#251d34",
      "layout_background_1": "#1e162c",
      "layout_background_2": "#2b233b",
      "layout_background_3": "#342b45",
      "layout_background_4": "#403654",
      "layout_color_0": "#e9e4f4",
      "layout_color_1": "#e9e4f4",
      "layout_color_2": "#c3bece",
      "layout_color_3": "#8a839a",
      "layout_border_0": "#342b45",
      "layout_border_1": "#403654",
      "layout_border_2": "#736b84",
      "tree_view_bg": "#251d34",
      "tree_pane_bg": "#1e162c",
      "tree_card_bg": "#251d34",
      "button_bg": "#2b233b",
      "calendar_view_toggle_bg": "#2b233b",
      "calendar_view_toggle_hover_bg": "#342b45",
      "calendar_today_bg": "#2b233b",
      "calendar_weekend_bg": "#181025",
      "calendar_today_weekend_bg": "#2b233b",
      "calendar_week_label_bg": "#342b45",
      "calendar_day_label_selected_bg": "#be4c8d",
      "calendar_day_label_selected_text": "#ffffff",
      "calendar_dragbox_bg": "#4c2e48",
      "calendar_dropshadow_bg": "#4c2e48",
      "unread_color": "#e9e4f4",
      "new_subject_color": "#e9e4f4",
      "new_color": "#bb95fc",
      "link_color": "#86c0cc",
      "darkberry_accent_text": "#bb95fc",
      "folder_unread_count_bg": "#be4c8d",
      "folder_unread_new_count_bg": "#be4c8d",
      "folder_unread_count_text": "#ffffff",
      "folder_total_count_bg": "#342b45",
      "folder_total_count_text": "#e9e4f4",
      "color_gray_70": "#1e162c",
      "color_gray_50": "#342b45"
    },
    "properties": {
      "color_scheme": "dark",
      "content_color_scheme": "dark"
    }
  }
}
