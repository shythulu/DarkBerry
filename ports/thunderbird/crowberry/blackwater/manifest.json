      "layout_border_2": "#615971",
      "tree_view_bg": "#191126",
      "tree_pane_bg": "#130c20",
      "tree_card_bg": "#191126",
      "button_bg": "#221a30",
      "calendar_view_toggle_bg": "#221a30",
      "calendar_view_toggle_hover_bg": "#2c233c",
      "calendar_today_bg": "#221a30",
      "calendar_weekend_bg": "#0f081b",
      "calendar_today_weekend_bg": "#221a30",
      "calendar_week_label_bg": "#2c233c",
      "calendar_day_label_selected_bg": "#ba4889",
      "calendar_day_label_selected_text": "#ffffff",
      "calendar_dragbox_bg": "#42243d",
      "calendar_dropshadow_bg": "#42243d",
      "unread_color": "#e7e2f2",
      "new_subject_color": "#e7e2f2",
      "new_color": "#bb95fc",
      "link_color": "#86c0cc",
      "darkberry_accent_text": "#bb95fc",
      "folder_unread_count_bg": "#ba4889",
      "folder_unread_new_count_bg": "#ba4889",
      "folder_unread_count_text": "#ffffff",
      "folder_total_count_bg": "#2c233c",
      "folder_total_count_text": "#e7e2f2",
      "color_gray_70": "#130c20",
      "color_gray_50": "#2c233c"
