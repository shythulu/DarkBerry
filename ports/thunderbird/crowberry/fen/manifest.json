      "tree_card_bg": "#403654",
      "button_bg": "#4d4362",
      "calendar_view_toggle_bg": "#4d4362",
      "calendar_view_toggle_hover_bg": "#5c5172",
      "calendar_today_bg": "#4d4362",
      "calendar_weekend_bg": "#2c233d",
      "calendar_today_weekend_bg": "#4d4362",
      "calendar_week_label_bg": "#5c5172",
      "calendar_day_label_selected_bg": "#dc67a7",
