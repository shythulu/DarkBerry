      "popup_text": "#f5dee4",
      "popup_border": "#3d212a",
      "popup_highlight": "#ba4889",
      "popup_highlight_text": "#ffffff",
      "sidebar": "#200b12",
      "sidebar_text": "#f5dee4",
      "sidebar_border": "#3d212a",
      "sidebar_highlight": "#ba4889",
      "sidebar_highlight_text": "#ffffff",
      "sidebar_highlight_border": "#ba4889",
      "button_background_hover": "#301820",
      "button_background_active": "#3d212a",
      "spaces_bg": "#1a070d",
      "spaces_button_active_bg": "#ba4889",
      "spaces_button_active_text": "#ffffff",
      "tabs_toolbar_bg": "#1a070d",
      "layout_background_0": "#261017",
      "layout_background_1": "#200b12",
      "layout_background_2": "#301820",
      "layout_background_3": "#3d212a",
      "layout_background_4": "#4b2c35",
      "layout_color_0": "#f5dee4",
      "layout_color_1": "#f5dee4",
      "layout_color_2": "#ccb5bb",
      "layout_color_3": "#90757c",
      "layout_border_0": "#3d212a",
      "layout_border_1": "#4b2c35",
      "layout_border_2": "#71555d",
      "tree_view_bg": "#261017",
      "tree_pane_bg": "#200b12",
      "tree_card_bg": "#261017",
      "button_bg": "#301820",
      "calendar_view_toggle_bg": "#301820",
      "calendar_view_toggle_hover_bg": "#3d212a",
      "calendar_today_bg": "#301820",
      "calendar_weekend_bg": "#1a070d",
      "calendar_today_weekend_bg": "#301820",
      "calendar_week_label_bg": "#3d212a",
      "calendar_day_label_selected_bg": "#ba4889",
      "calendar_day_label_selected_text": "#ffffff",
      "calendar_dragbox_bg": "#4d2331",
      "calendar_dropshadow_bg": "#4d2331",
      "unread_color": "#f5dee4",
      "new_subject_color": "#f5dee4",
      "new_color": "#fc7ca8",
      "link_color": "#86c0cc",
      "darkberry_accent_text": "#fc7ca8",
      "folder_unread_count_bg": "#ba4889",
      "folder_unread_new_count_bg": "#ba4889",
      "folder_unread_count_text": "#ffffff",
      "folder_total_count_bg": "#3d212a",
      "folder_total_count_text": "#f5dee4",
      "color_gray_70": "#200b12",
      "color_gray_50": "#3d212a"
    },
    "properties": {
      "color_scheme": "dark",
      "content_color_scheme": "dark"
    }
  }
}
