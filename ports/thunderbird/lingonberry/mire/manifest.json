      "layout_color_3": "#997f86",
      "layout_border_0": "#462832",
      "layout_border_1": "#55323d",
      "layout_border_2": "#83676f",
      "tree_view_bg": "#341c23",
      "tree_pane_bg": "#2c141c",
      "tree_card_bg": "#341c23",
      "button_bg": "#3b2129",
      "calendar_view_toggle_bg": "#3b2129",
      "calendar_view_toggle_hover_bg": "#462832",
      "calendar_today_bg": "#3b2129",
      "calendar_weekend_bg": "#250f16",
      "calendar_today_weekend_bg": "#3b2129",
      "calendar_week_label_bg": "#462832",
      "calendar_day_label_selected_bg": "#be4c8d",
      "calendar_day_label_selected_text": "#ffffff",
      "calendar_dragbox_bg": "#582d3a",
      "calendar_dropshadow_bg": "#582d3a",
      "unread_color": "#f7e0e6",
      "new_subject_color": "#f7e0e6",
      "new_color": "#fc7ca8",
      "link_color": "#86c0cc",
      "darkberry_accent_text": "#fc7ca8",
      "folder_unread_count_bg": "#be4c8d",
      "folder_unread_new_count_bg": "#be4c8d",
      "folder_unread_count_text": "#ffffff",
      "folder_total_count_bg": "#462832",
      "folder_total_count_text": "#f7e0e6",
      "color_gray_70": "#2c141c",
      "color_gray_50": "#462832"
    },
    "properties": {
      "color_scheme": "dark",
      "content_color_scheme": "dark"
    }
