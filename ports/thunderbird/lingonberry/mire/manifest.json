      "lwt_frame": "#250f16",
      "spaces_bg": "#250f16",
      "spaces_button_active_bg": "#be4c8d",
      "spaces_button_active_text": "#ffffff",
      "tabs_toolbar_bg": "#250f16",
      "layout_background_0": "#341c23",
