{
  "manifest_version": 2,
  "name": "Blueberry Blackwater",
  "version": "0.3.0",
  "description": "Blueberry for Firefox. Blueberry tint of Blackwater: dark, neutrals leaned toward blueberry (base #0d1529).",
  "homepage_url": "https://shythulu.github.io/DarkBerry/",
  "browser_specific_settings": {
    "gecko": {
      "id": "blueberry-blackwater@blueberry-theme"
    }
  },
  "theme": {
    "colors": {
      "frame": "#050b1e",
      "frame_inactive": "#050b1e",
      "tab_selected": "#0d1529",
      "tab_text": "#dee5f4",
      "tab_background_text": "#b5bccb",
      "tab_line": "#87aafd",
      "tab_loading": "#ba4889",
      "toolbar": "#0d1529",
      "toolbar_text": "#dee5f4",
      "bookmark_text": "#dee5f4",
      "icons": "#b5bccb",
      "icons_attention": "#ba4889",
      "toolbar_field": "#151e33",
      "toolbar_field_text": "#dee5f4",
      "toolbar_field_border": "#1e2840",
      "toolbar_field_focus": "#151e33",
      "toolbar_field_text_focus": "#dee5f4",
      "toolbar_field_border_focus": "#ba4889",
      "toolbar_field_highlight": "#38283f",
      "toolbar_field_highlight_text": "#dee5f4",
      "toolbar_top_separator": "#050b1e",
      "toolbar_bottom_separator": "#151e33",
      "toolbar_vertical_separator": "#1e2840",
      "popup": "#080f23",
      "popup_text": "#dee5f4",
      "popup_border": "#1e2840",
      "popup_highlight": "#38283f",
      "popup_highlight_text": "#dee5f4",
      "sidebar": "#080f23",
      "sidebar_text": "#dee5f4",
      "sidebar_border": "#151e33",
      "sidebar_highlight": "#38283f",
      "sidebar_highlight_text": "#dee5f4",
      "ntp_background": "#0d1529",
      "ntp_text": "#dee5f4",
      "button_background_hover": "#151e33",
      "button_background_active": "#1e2840"
    },
    "properties": {
      "color_scheme": "dark",
      "content_color_scheme": "dark"
    }
  }
}
