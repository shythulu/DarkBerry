{
  "manifest_version": 2,
  "name": "Darkberry Fen",
  "version": "0.3.0",
  "description": "Darkberry for Firefox. Soft dark. The background (#4c3342) is within a shade of the paint colour.",
  "homepage_url": "https://shythulu.github.io/DarkBerry/",
  "browser_specific_settings": {
    "gecko": {
      "id": "darkberry-fen@darkberry-theme"
    }
  },
  "theme": {
    "colors": {
      "frame": "#35212e",
      "frame_inactive": "#35212e",
      "tab_selected": "#4f3143",
      "tab_text": "#f2e6ee",
      "tab_background_text": "#ccbac5",
      "tab_line": "#fa99b4",
      "tab_loading": "#ba4889",
      "toolbar": "#4f3143",
      "toolbar_text": "#f2e6ee",
      "bookmark_text": "#f2e6ee",
      "icons": "#ccbac5",
      "icons_attention": "#ba4889",
      "toolbar_field": "#5d3e51",
      "toolbar_field_text": "#f2e6ee",
      "toolbar_field_border": "#6c4c60",
      "toolbar_field_focus": "#5d3e51",
      "toolbar_field_text_focus": "#f2e6ee",
      "toolbar_field_border_focus": "#ba4889",
      "toolbar_field_highlight": "#6e4457",
      "toolbar_field_highlight_text": "#f2e6ee",
      "toolbar_top_separator": "#35212e",
      "toolbar_bottom_separator": "#5d3e51",
      "toolbar_vertical_separator": "#6c4c60",
      "popup": "#402838",
      "popup_text": "#f2e6ee",
      "popup_border": "#6c4c60",
      "popup_highlight": "#6e4457",
      "popup_highlight_text": "#f2e6ee",
      "sidebar": "#402838",
      "sidebar_text": "#f2e6ee",
      "sidebar_border": "#5d3e51",
      "sidebar_highlight": "#6e4457",
      "sidebar_highlight_text": "#f2e6ee",
      "ntp_background": "#4f3143",
      "ntp_text": "#f2e6ee",
      "button_background_hover": "#5d3e51",
      "button_background_active": "#6c4c60"
    },
    "properties": {
      "color_scheme": "dark",
      "content_color_scheme": "dark"
    }
  }
}
