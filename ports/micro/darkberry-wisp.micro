# Darkberry Wisp for micro. Light. Text is a violet-leaning cousin of the paint colour.
# Generated by build.mjs from src/ports/micro.micro. Do not edit ports/micro/.
# Copy into ~/.config/micro/colorschemes/, then: set colorscheme darkberry-wisp

color-link default "#4f3143,#fbf4f8"
color-link comment "#806776"
color-link identifier "#a15873"
color-link identifier.class "#9a4cc0"
color-link identifier.var "#725388"
color-link constant "#3b5fd0"
color-link constant.number "#90670a"
color-link constant.string "#377a37"
color-link constant.string.char "#377a37"
color-link constant.specialChar "#1d7d6c"
color-link statement "#d21570"
color-link preproc "#7a58b0"
color-link type "#9a4cc0"
color-link type.keyword "#d21570"
color-link symbol "#8e7584"
color-link symbol.brackets "#8e7584"
color-link symbol.operator "#775d6d"
color-link symbol.tag "#9a4cc0"
color-link special "#b7437d"
color-link underlined "#1b778c"
color-link error "#ffffff,#cc3838"
color-link todo "#90670a"
color-link ignore "#967d8c"

color-link indent-char "#967d8c"
color-link line-number "#967d8c,#f3e6ef"
color-link current-line-number "#b9488b,#f3e6ef"
color-link gutter-error "#cc3838"
color-link gutter-warning "#90670a"
color-link divider "#ac93a2,#fbf4f8"
# micro takes this group's FOREGROUND and uses it as the line's background,
# discarding any background given (internal/display/bufwindow.go). So this is
# one colour, and it has to be a background: naming ui.text here painted the
# cursor line near-white and left the text on it invisible.
color-link cursor-line "#dfcbd8"
color-link color-column "#dfcbd8"
color-link selection "#4f3143,#d191b2"
color-link match-brace "#b9488b,#d0bac8"
color-link hlsearch "#ffffff,#b9488b"
color-link statusline "#4f3143,#f3e6ef"
color-link tabbar "#694e5f,#ebdae5"
color-link scrollbar "#ac93a2"
color-link message "#1d7d6c"
color-link error-message "#ffffff,#cc3838"
color-link diff-added "#377a37"
color-link diff-modified "#90670a"
color-link diff-deleted "#bf414b"
