# Cloudberry Mire for micro. Cloudberry tint of Mire: dark, neutrals leaned toward cloudberry (base #341e13).
# Generated by build.mjs from src/ports/micro.micro. Do not edit ports/micro/.
# Copy into ~/.config/micro/colorschemes/, then: set colorscheme cloudberry-mire

color-link default "#f5e3da,#341e13"
color-link comment "#b1907f"
color-link identifier "#e7c5d8"
color-link identifier.class "#ddb0ec"
color-link identifier.var "#ebb092"
color-link constant "#8fb0f2"
color-link constant.number "#e8c98a"
color-link constant.string "#a3daa3"
color-link constant.string.char "#a3daa3"
color-link constant.specialChar "#9ed0c4"
color-link statement "#fd7ca5"
color-link preproc "#baa8dc"
color-link type "#ddb0ec"
color-link type.keyword "#fd7ca5"
color-link symbol "#988276"
color-link symbol.brackets "#988276"
color-link symbol.operator "#cfbdb3"
color-link symbol.tag "#ddb0ec"
color-link special "#feafd4"
color-link underlined "#86c0cc"
color-link error "#251106,#f06a6a"
color-link todo "#e8c98a"
color-link ignore "#988276"

color-link indent-char "#988276"
color-link line-number "#988276,#2c160a"
color-link current-line-number "#be4c8d,#2c160a"
color-link gutter-error "#f06a6a"
color-link gutter-warning "#e8c98a"
color-link divider "#988276,#341e13"
# micro takes this group's FOREGROUND and uses it as the line's background,
# discarding any background given (internal/display/bufwindow.go). So this is
# one colour, and it has to be a background: naming ui.text here painted the
# cursor line near-white and left the text on it invisible.
color-link cursor-line "#362014"
color-link color-column "#3b2316"
color-link selection "#f5e3da,#582f2d"
color-link match-brace "#be4c8d,#362014"
color-link hlsearch "#f5e3da,#513c3f"
color-link statusline "#f5e3da,#2c160a"
color-link tabbar "#cfbdb3,#251106"
color-link scrollbar "#988276"
color-link message "#9ed0c4"
color-link error-message "#251106,#f06a6a"
color-link diff-added "#a3daa3"
color-link diff-modified "#e8c98a"
color-link diff-deleted "#f38b77"
