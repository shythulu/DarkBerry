# Darkberry Fen for micro. Soft dark. The background (#4c3342) is within a shade of the paint colour.
# Generated by build.mjs from src/ports/micro.micro. Do not edit ports/micro/.
# Copy into ~/.config/micro/colorschemes/, then: set colorscheme darkberry-fen

color-link default "#f2e6ee,#4f3143"
color-link comment "#bd9fb1"
color-link identifier "#eedce5"
color-link identifier.class "#ecbcfc"
color-link identifier.var "#cdbcd2"
color-link constant "#a4c3f6"
color-link constant.number "#f0d6a0"
color-link constant.string "#b7e6b7"
color-link constant.string.char "#b7e6b7"
color-link constant.specialChar "#bad9d4"
color-link statement "#fa99b4"
color-link preproc "#cebede"
color-link type "#ecbcfc"
color-link type.keyword "#fa99b4"
color-link symbol "#ab8ca0"
color-link symbol.brackets "#ab8ca0"
color-link symbol.operator "#c3aab9"
color-link symbol.tag "#ecbcfc"
color-link special "#ffc4dd"
color-link underlined "#a0d0da"
color-link error "#ffffff,#ff8a8a"
color-link todo "#f0d6a0"
color-link ignore "#a28297"

color-link indent-char "#a28297"
color-link line-number "#a28297,#402838"
color-link current-line-number "#ba4889,#402838"
color-link gutter-error "#ff8a8a"
color-link gutter-warning "#f0d6a0"
color-link divider "#8f6e82,#4f3143"
# micro takes this group's FOREGROUND and uses it as the line's background,
# discarding any background given (internal/display/bufwindow.go). So this is
# one colour, and it has to be a background: naming ui.text here painted the
# cursor line near-white and left the text on it invisible.
color-link cursor-line "#5d3e51"
color-link color-column "#5d3e51"
color-link selection "#f2e6ee,#905f75"
color-link match-brace "#ba4889,#6c4c60"
color-link hlsearch "#ffffff,#ba4889"
color-link statusline "#f2e6ee,#402838"
color-link tabbar "#ccbac5,#35212e"
color-link scrollbar "#8f6e82"
color-link message "#bad9d4"
color-link error-message "#ffffff,#ff8a8a"
color-link diff-added "#b7e6b7"
color-link diff-modified "#f0d6a0"
color-link diff-deleted "#f39aa0"
