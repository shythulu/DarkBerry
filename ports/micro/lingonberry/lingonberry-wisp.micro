# Lingonberry Wisp for micro. Lingonberry tint of Wisp: light, neutrals leaned toward lingonberry (base #fff3f6).
# Generated by build.mjs from src/ports/micro.micro. Do not edit ports/micro/.
# Copy into ~/.config/micro/colorschemes/, then: set colorscheme lingonberry-wisp

color-link default "#572c3b,#fff3f6"
color-link comment "#785a63"
color-link identifier "#934b66"
color-link identifier.class "#8c3eb2"
color-link identifier.var "#49577d"
color-link constant "#3659ca"
color-link constant.number "#815b02"
color-link constant.string "#2c6f2d"
color-link constant.string.char "#2c6f2d"
color-link constant.specialChar "#006f5f"
color-link statement "#bf0b64"
color-link preproc "#6e52ab"
color-link type "#8c3eb2"
color-link type.keyword "#bf0b64"
color-link symbol "#94757d"
color-link symbol.brackets "#94757d"
color-link symbol.operator "#6b414e"
color-link symbol.tag "#8c3eb2"
color-link special "#a63676"
color-link underlined "#026b80"
color-link error "#ffffff,#bb262a"
color-link todo "#815b02"
color-link ignore "#9b7c84"

color-link indent-char "#9b7c84"
color-link line-number "#9b7c84,#f9e4ea"
color-link current-line-number "#b9488b,#f9e4ea"
color-link gutter-error "#bb262a"
color-link gutter-warning "#815b02"
color-link divider "#9b7c84,#fff3f6"
# micro takes this group's FOREGROUND and uses it as the line's background,
# discarding any background given (internal/display/bufwindow.go). So this is
# one colour, and it has to be a background: naming ui.text here painted the
# cursor line near-white and left the text on it invisible.
color-link cursor-line "#f5e5e9"
color-link color-column "#e2cbd1"
color-link selection "#572c3b,#f3c9dc"
color-link match-brace "#b9488b,#f5e5e9"
color-link hlsearch "#572c3b,#dfd0e6"
color-link statusline "#572c3b,#f9e4ea"
color-link tabbar "#744956,#efd9df"
color-link scrollbar "#9b7c84"
color-link message "#006f5f"
color-link error-message "#ffffff,#bb262a"
color-link diff-added "#2c6f2d"
color-link diff-modified "#815b02"
color-link diff-deleted "#9e4116"
