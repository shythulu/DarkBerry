# Lingonberry Fen for micro. Lingonberry tint of Fen: dark, neutrals leaned toward lingonberry (base #55323d).
# Generated by build.mjs from src/ports/micro.micro. Do not edit ports/micro/.
# Copy into ~/.config/micro/colorschemes/, then: set colorscheme lingonberry-fen

color-link default "#fae3e9,#55323d"
color-link comment "#c19ea8"
color-link identifier "#ecaed2"
color-link identifier.class "#edbbfe"
color-link identifier.var "#ecbda8"
color-link constant "#a4c3f6"
color-link constant.number "#f0d6a0"
color-link constant.string "#bbe5b3"
color-link constant.string.char "#bbe5b3"
color-link constant.specialChar "#afdfdb"
color-link statement "#fe96b4"
color-link preproc "#c9b0e8"
color-link type "#edbbfe"
color-link type.keyword "#fe96b4"
color-link symbol "#a6828c"
color-link symbol.brackets "#a6828c"
color-link symbol.operator "#d2b8bf"
color-link symbol.tag "#edbbfe"
color-link special "#ffc4dd"
color-link underlined "#83d4db"
color-link error "#3d2029,#fd8c85"
color-link todo "#f0d6a0"
color-link ignore "#a6828c"

color-link indent-char "#a6828c"
color-link line-number "#a6828c,#482832"
color-link current-line-number "#dc67a7,#482832"
color-link gutter-error "#fd8c85"
color-link gutter-warning "#f0d6a0"
color-link divider "#a6828c,#55323d"
# micro takes this group's FOREGROUND and uses it as the line's background,
# discarding any background given (internal/display/bufwindow.go). So this is
# one colour, and it has to be a background: naming ui.text here painted the
# cursor line near-white and left the text on it invisible.
color-link cursor-line "#5a3742"
color-link color-column "#643f4a"
color-link selection "#fae3e9,#734452"
color-link match-brace "#dc67a7,#5a3742"
color-link hlsearch "#fae3e9,#6f4e63"
color-link statusline "#fae3e9,#482832"
color-link tabbar "#d2b8bf,#3d2029"
color-link scrollbar "#a6828c"
color-link message "#afdfdb"
color-link error-message "#3d2029,#fd8c85"
color-link diff-added "#bbe5b3"
color-link diff-modified "#f0d6a0"
color-link diff-deleted "#faa692"
