{
  "$comment": "Layer 2: semantic roles. Every port references these names. A value is a palette colour, another role, mix(a,b,t), or {dark,light}. 'catppuccin' records Catppuccin's choice for the same role; '=' means aligned. A deviation must carry a 'why'.",
  "ui": {
    "background": {
      "value": "base",
      "catppuccin": "="
    },
    "pane.secondary": {
      "value": "mantle",
      "catppuccin": "="
    },
    "pane.tertiary": {
      "value": "crust",
      "catppuccin": "="
    },
    "text": {
      "value": "text",
      "catppuccin": "="
    },
    "text.muted": {
      "value": "subtext0",
      "catppuccin": "="
    },
    "text.subtle": {
      "value": "overlay1",
      "catppuccin": "="
    },
    "accent": {
      "value": "jam",
      "catppuccin": "lavender (terminal borders), blue (tags)",
      "why": "Jam, the deeper pink already used for fills, carries the accent too, so focus and activity sit at the same weight as buttons and badges."
    },
    "on.accent": {
      "value": "base",
      "catppuccin": "="
    },
    "fill": {
      "value": "jam",
      "catppuccin": "no equivalent (accents are used as fills directly)",
      "why": "A deeper jam colour is kept for buttons, badges and progress bars, so saturated pink never covers large areas."
    },
    "on.fill": {
      "value": "onjam",
      "catppuccin": "base (text on accent)",
      "why": "Base on jam fails contrast in every flavour (about 3:1). White passes at 4.8:1."
    },
    "focus": {
      "value": "mix(cherry,overlay1,0.5)",
      "catppuccin": "lavender",
      "why": "A soft berry focus ring stays visible without competing with the berry accent."
    },
    "border.active": {
      "value": "ui.accent",
      "catppuccin": "lavender",
      "why": "Follows ui.accent."
    },
    "border.inactive": {
      "value": "overlay0",
      "catppuccin": "="
    },
    "cursor": {
      "value": "petal",
      "catppuccin": "rosewater",
      "why": "A bright rose cursor is easy to find on dark, wine-tinted backgrounds; blossom, the rosewater slot, is too dusty for that."
    },
    "cursor.text": {
      "value": {
        "dark": "crust",
        "light": "base"
      },
      "catppuccin": "="
    },
    "selection": {
      "value": "mix(surface1,berry,0.25)",
      "catppuccin": "overlay2 at 20-30% opacity",
      "why": "Selections are tinted with berry so they read as part of the theme rather than as grey."
    },
    "link": {
      "value": "frost",
      "catppuccin": "blue",
      "why": "Links are teal-blue frost because blueberry already carries constants."
    },
    "success": {
      "value": "gooseberry",
      "catppuccin": "="
    },
    "warning": {
      "value": "honey",
      "catppuccin": "="
    },
    "error": {
      "value": "cranberry",
      "catppuccin": "="
    },
    "info": {
      "value": "juniper",
      "catppuccin": "="
    },
    "bell": {
      "value": "honey",
      "catppuccin": "="
    },
    "mark1": {
      "value": "lavender",
      "catppuccin": "="
    },
    "mark2": {
      "value": "plum",
      "catppuccin": "="
    },
    "mark3": {
      "value": "bilberry",
      "catppuccin": "="
    },
    "mark.text": {
      "value": "ui.cursor.text",
      "catppuccin": "="
    },
    "tab.active": {
      "value": "ui.background"
    },
    "tab.inactive": {
      "value": "ui.pane.secondary"
    },
    "tab.indicator": {
      "value": "jam",
      "minContrastWith": [
        "ui.on.tab.indicator",
        4.5
      ],
      "note": "Follows ui.fill, so the active tab reads as the same jam chip as buttons and badges."
    },
    "on.tab.indicator": {
      "value": "ui.on.fill"
    },
    "badge": {
      "value": "ui.fill",
      "minContrastWith": [
        "ui.on.badge",
        4.5
      ]
    },
    "on.badge": {
      "value": "ui.on.fill"
    }
  },
  "terminal": {
    "color16": {
      "value": "apricot",
      "catppuccin": "="
    },
    "color17": {
      "value": "blossom",
      "catppuccin": "="
    }
  },
  "syntax": {
    "$why": "Darkberry's syntax mapping: warm berry tones carry structure (keywords, functions, types) and cooler tones carry values (constants, strings, regex).",
    "text": {
      "value": "text",
      "catppuccin": "="
    },
    "keyword": {
      "value": "berry",
      "catppuccin": "mauve",
      "why": "syntax.$why",
      "minContrast": 4.5,
      "key": true
    },
    "function": {
      "value": "petal",
      "catppuccin": "blue",
      "why": "syntax.$why",
      "minContrast": 4.5,
      "key": true
    },
    "type": {
      "value": "plum",
      "catppuccin": "yellow",
      "why": "syntax.$why",
      "minContrast": 4.5,
      "key": true
    },
    "namespace": {
      "value": "lavender",
      "catppuccin": "yellow (as types)",
      "why": "Namespaces get their own cooler lilac so module names stay distinct from types.",
      "minContrast": 4.5,
      "key": true
    },
    "constant": {
      "value": "blueberry",
      "catppuccin": "peach",
      "why": "syntax.$why",
      "minContrast": 4.5,
      "key": true
    },
    "number": {
      "value": "honey",
      "catppuccin": "peach",
      "why": "syntax.$why",
      "minContrast": 4.5,
      "key": true
    },
    "string": {
      "value": "gooseberry",
      "catppuccin": "=",
      "minContrast": 4.5,
      "key": true
    },
    "regex": {
      "value": "juniper",
      "catppuccin": "pink",
      "why": "syntax.$why",
      "minContrast": 4.5,
      "key": true
    },
    "variable": {
      "value": "blossom",
      "catppuccin": "text (maroon for parameters)",
      "why": "Identifiers take a muted rose so code keeps a berry cast without shouting.",
      "minContrast": 4.5,
      "key": true
    },
    "property": {
      "value": "mix(lavender,subtext0,0.5)",
      "catppuccin": "blue",
      "why": "A mauve-grey keeps object keys quieter than functions.",
      "minContrast": 4.5
    },
    "operator": {
      "value": "mix(overlay2,subtext0,0.4)",
      "catppuccin": "sky",
      "why": "Structural glue recedes instead of being coloured.",
      "minContrast": 3
    },
    "punctuation": {
      "value": "mix(overlay1,overlay2,0.35)",
      "catppuccin": "overlay2",
      "why": "Slightly quieter than comments, so brackets fade behind code.",
      "minContrast": 3
    },
    "comment": {
      "value": "overlay2",
      "catppuccin": "=",
      "minContrast": 4.5
    },
    "link": {
      "value": "ui.link",
      "catppuccin": "blue",
      "why": "Follows ui.link.",
      "minContrast": 4.5
    },
    "error": {
      "value": "ui.error",
      "catppuccin": "=",
      "minContrast": 4.5,
      "key": true
    },
    "deprecated": {
      "value": "mix(overlay1,overlay2,0.6)",
      "catppuccin": "no equivalent",
      "why": "A dimmed grey marks code on its way out.",
      "minContrast": 3
    },
    "unimplemented": {
      "value": "mix(overlay1,lavender,0.2)",
      "catppuccin": "no equivalent",
      "why": "A faint lilac-grey marks stubs and placeholders.",
      "minContrast": 3
    },
    "diff.removed": {
      "value": "mix(cranberry,cherry,0.5)",
      "catppuccin": "red",
      "why": "A softer red for removed lines, so diffs don't read as errors.",
      "minContrast": 4.5
    }
  },
  "ansi": {
    "$comment": "ANSI colours are palette-level, as in Catppuccin, and follow its mapping and bright formula exactly.",
    "red": "cranberry",
    "green": "gooseberry",
    "yellow": "honey",
    "blue": "blueberry",
    "magenta": "berry",
    "cyan": "juniper"
  }
}
