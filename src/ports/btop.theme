# %FULL% for btop. %NOTE%
#
# Generated by build.mjs from src/ports/btop.theme. Do not edit ports/btop/.
# Install with:  cp %SLUG%.theme ~/.config/btop/themes/
# ($XDG_CONFIG_HOME/btop/themes/ when that is set; a Snap keeps its config under
# ~/snap/btop/current/.config/btop/themes/). btop lists a theme by its file name without
# the extension, so keep the name: pick "%SLUG%" under Esc > Options > Color theme, or set
#   color_theme = "%SLUG%"
# in ~/.config/btop/btop.conf. No restart or version bump is needed; btop re-reads the
# themes folder when the options menu opens. Truecolor is on by default; on a terminal
# without it, set `lowcolor = True` and btop rounds every value to xterm-256 itself.
#
# Needs btop 1.3 or newer for the whole file to apply, and 1.4.7 for the last six keys
# (proc_pause_bg, proc_follow_bg, proc_banner_bg, proc_banner_fg, followed_bg,
# followed_fg: the "list paused" / "following process" banner and the followed row).
# Older releases skip keys they do not know, so this file loads on any 1.x; those six
# simply have no effect there.
#
# main_bg is set. For a transparent terminal, set `theme_background = False` in
# btop.conf rather than blanking the key: that is btop's own switch, and it keeps
# every other colour here intact.
#
# Gradients (the *_start / *_mid / *_end triples) are palette progressions, low to
# high. Each adjacent pair is at least 5 apart in OKLab distance x100 in every flavour,
# the floor the build uses for syntax colours, so the three steps stay tellable apart in
# a one-cell meter. Only the temperature gradient carries a status meaning (fine, warm,
# hot), so only it goes through the status roles; the other meters are hue walks, not
# alarms, following the Catppuccin port's choice not to paint a full disk red.
#
# Pairings the build cannot check (measured with lib/color.mjs contrast(), per
# flavour Wisp / Fen / Mire / Blackwater):
#   proc_banner_fg (ui.on.error) on proc_pause_bg (ui.warning):   6.1 / 10.5 / 11.5 / 12.3
#   proc_banner_fg (ui.on.error) on proc_follow_bg (ui.info):     6.1 / 10.2 / 10.7 / 11.5
#   proc_banner_fg (ui.on.error) on proc_banner_bg (their mix):   6.7 / 10.3 / 11.0 / 11.8
#   proc_misc sparkline (blossom) on selected_bg (ui.fill):       1.3 /  1.8 /  2.9 /  3.1
#     The per-process mini CPU graph keeps proc_misc on the selected row; btop offers no
#     key for it. It is a graph, not text, and the row's text is all selected_fg.
#   selected_fg on selected_bg and followed_fg on followed_bg are role pairs
#     (ui.on.fill on ui.fill, ui.mark.text on ui.mark1) the build checks at 4.5:1.
#
# Differs from Catppuccin:
#   selected_bg / selected_fg: the process row selection is ui.fill under ui.on.fill
#     (a row selection, not a text selection); Catppuccin uses surface1 under blue.
#   hi_fg: keyboard shortcut letters take `tint`, accent as readable text; Catppuccin
#     uses blue, its accent.
#   graph_text: ui.text; Catppuccin uses rosewater. Uptime and the network scale are
#     text you read, drawn over a graph, so they take the reading colour.
#   meter_bg: surface2, one step above Catppuccin's surface1, so the empty part of a
#     meter is still a visible track on Mire and Blackwater (1.4:1 instead of 1.2:1).
#   div_line: ui.border.inactive (overlay1) where Catppuccin has overlay0; that role's
#     `why` records overlay0 failing 3:1 on three flavours. It therefore shares a colour
#     with inactive_fg (ui.text.subtle, also overlay1).
#   cached gradient: frost > bilberry > lavender rather than the slot-for-slot
#     bilberry > blueberry > lavender, whose first step is 2.4 to 3.7 apart (two blues).
#   Box outlines follow Catppuccin's slots (mauve > plum, green > gooseberry,
#     maroon > cherry, blue > bilberry); bilberry rather than blueberry for the process
#     box so the outline is not the ANSI blue every terminal listing already uses.

# Main background. Empty means the terminal's own background; use theme_background=False instead.
theme[main_bg]="{ui.background}"

# Main text colour
theme[main_fg]="{ui.text}"

# Title colour for boxes
theme[title]="{ui.text}"

# Highlight colour for keyboard shortcuts: the accent as readable text
theme[hi_fg]="{tint}"

# Background and foreground of the selected row in the processes box (a row selection)
theme[selected_bg]="{ui.fill}"
theme[selected_fg]="{ui.on.fill}"

# Inactive / disabled text (unselected menu entries, disabled cores). Never body text.
theme[inactive_fg]="{ui.text.subtle}"

# Text on top of graphs: uptime, the network graph's scale
theme[graph_text]="{ui.text}"

# Empty part of a percentage meter: a track (structural; surface2, the strong border step)
theme[meter_bg]="{surface2}"

# Per-process mini CPU sparklines, the details memory graph and the "Running" status
# text (structural; blossom, the rosewater slot Catppuccin also uses here)
theme[proc_misc]="{blossom}"

# Box outlines: each box keeps its own hue (structural; the same slots as Catppuccin)
theme[cpu_box]="{plum}"
theme[mem_box]="{gooseberry}"
theme[net_box]="{cherry}"
theme[proc_box]="{bilberry}"

# Dividers inside a box and the small boxes' outlines: an unfocused split edge
theme[div_line]="{ui.border.inactive}"

# Temperature graph: fine > warm > hot, the status roles
theme[temp_start]="{ui.success}"
theme[temp_mid]="{ui.warning}"
theme[temp_end]="{ui.error}"

# CPU graph: teal > blue > lilac (juniper > bilberry > lavender), cooling into the theme's violet
theme[cpu_start]="{juniper}"
theme[cpu_mid]="{bilberry}"
theme[cpu_end]="{lavender}"

# Mem/disk free meter: plum > lavender > blueberry
theme[free_start]="{plum}"
theme[free_mid]="{lavender}"
theme[free_end]="{blueberry}"

# Mem/disk cached meter: frost > bilberry > lavender
theme[cached_start]="{frost}"
theme[cached_mid]="{bilberry}"
theme[cached_end]="{lavender}"

# Mem/disk available meter: apricot > cherry > cranberry (warm walk, not an alarm)
theme[available_start]="{apricot}"
theme[available_mid]="{cherry}"
theme[available_end]="{cranberry}"

# Mem/disk used meter: gooseberry > juniper > frost
theme[used_start]="{gooseberry}"
theme[used_mid]="{juniper}"
theme[used_end]="{frost}"

# Download graph: the same warm walk as the available meter
theme[download_start]="{apricot}"
theme[download_mid]="{cherry}"
theme[download_end]="{cranberry}"

# Upload graph: the same cool walk as the used meter
theme[upload_start]="{gooseberry}"
theme[upload_mid]="{juniper}"
theme[upload_end]="{frost}"

# Process box gradient for the cpu, memory and thread columns: bilberry > lavender > plum
theme[process_start]="{bilberry}"
theme[process_mid]="{lavender}"
theme[process_end]="{plum}"

# btop 1.4.7+: the banner at the foot of the process box. Paused is a warning fill,
# following an info fill, both at once their mix; the one text colour btop allows on
# them is the on-status colour.
theme[proc_pause_bg]="{ui.warning}"
theme[proc_follow_bg]="{ui.info}"
theme[proc_banner_bg]="{mix(ui.warning,ui.info,0.5)}"
theme[proc_banner_fg]="{ui.on.error}"

# btop 1.4.7+: the followed process's row, a user mark rather than the selection
theme[followed_bg]="{ui.mark1}"
theme[followed_fg]="{ui.mark.text}"
