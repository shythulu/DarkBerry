# %FULL% for micro. %NOTE%
# Generated by build.mjs from src/ports/micro.micro. Do not edit ports/micro/.
# Copy into ~/.config/micro/colorschemes/, then: set colorscheme %SLUG%

color-link default "{ui.text},{ui.background}"
color-link comment "{syntax.comment}"
color-link identifier "{syntax.variable}"
color-link identifier.class "{syntax.type}"
color-link identifier.var "{syntax.property}"
color-link constant "{syntax.constant}"
color-link constant.number "{syntax.number}"
color-link constant.string "{syntax.string}"
color-link constant.string.char "{syntax.string}"
color-link constant.specialChar "{syntax.regex}"
color-link statement "{syntax.keyword}"
color-link preproc "{syntax.namespace}"
color-link type "{syntax.type}"
color-link type.keyword "{syntax.keyword}"
color-link symbol "{syntax.punctuation}"
color-link symbol.brackets "{syntax.punctuation}"
color-link symbol.operator "{syntax.operator}"
color-link symbol.tag "{syntax.type}"
color-link special "{syntax.function}"
color-link underlined "{syntax.link}"
color-link error "{ui.on.fill},{ui.error}"
color-link todo "{ui.warning}"
color-link ignore "{ui.text.subtle}"

color-link indent-char "{ui.text.subtle}"
color-link line-number "{ui.text.subtle},{ui.pane.secondary}"
color-link current-line-number "{ui.accent},{ui.pane.secondary}"
color-link gutter-error "{ui.error}"
color-link gutter-warning "{ui.warning}"
color-link divider "{ui.border.inactive},{ui.background}"
color-link cursor-line "{ui.text},{surface0}"
color-link color-column "{surface0}"
color-link selection "{ui.text},{ui.selection}"
color-link match-brace "{ui.accent},{surface1}"
color-link hlsearch "{ui.on.fill},{ui.fill}"
color-link statusline "{ui.text},{ui.pane.secondary}"
color-link tabbar "{ui.text.muted},{ui.pane.tertiary}"
color-link scrollbar "{ui.border.inactive}"
color-link message "{ui.info}"
color-link error-message "{ui.on.fill},{ui.error}"
color-link diff-added "{ui.success}"
color-link diff-modified "{ui.warning}"
color-link diff-deleted "{syntax.diff.removed}"
