{
  "manifest_version": 2,
  "name": "%FULL%",
  "version": "%VERSION%",
  "description": "%NAME% for Firefox. %NOTE%",
  "browser_specific_settings": { "gecko": { "id": "%SLUG%@%ID%-theme" } },
  "theme": {
    "colors": {
      "frame": "{ui.pane.tertiary}",
      "frame_inactive": "{ui.pane.tertiary}",
      "tab_selected": "{ui.tab.active}",
      "tab_text": "{ui.text}",
      "tab_background_text": "{ui.text.muted}",
      "tab_line": "{ui.tab.indicator}",
      "tab_loading": "{ui.accent}",
      "toolbar": "{ui.background}",
      "toolbar_text": "{ui.text}",
      "bookmark_text": "{ui.text}",
      "icons": "{ui.text.muted}",
      "icons_attention": "{ui.accent}",
      "toolbar_field": "{surface0}",
      "toolbar_field_text": "{ui.text}",
      "toolbar_field_border": "{surface1}",
      "toolbar_field_focus": "{surface0}",
      "toolbar_field_text_focus": "{ui.text}",
      "toolbar_field_border_focus": "{ui.accent}",
      "toolbar_field_highlight": "{ui.selection}",
      "toolbar_field_highlight_text": "{ui.text}",
      "toolbar_top_separator": "{ui.pane.tertiary}",
      "toolbar_bottom_separator": "{surface0}",
      "toolbar_vertical_separator": "{surface1}",
      "popup": "{ui.pane.secondary}",
      "popup_text": "{ui.text}",
      "popup_border": "{surface1}",
      "popup_highlight": "{ui.selection}",
      "popup_highlight_text": "{ui.text}",
      "sidebar": "{ui.pane.secondary}",
      "sidebar_text": "{ui.text}",
      "sidebar_border": "{surface0}",
      "sidebar_highlight": "{ui.selection}",
      "sidebar_highlight_text": "{ui.text}",
      "ntp_background": "{ui.background}",
      "ntp_text": "{ui.text}",
      "button_background_hover": "{surface0}",
      "button_background_active": "{surface1}"
    },
    "properties": { "color_scheme": "%SCHEME%", "content_color_scheme": "%SCHEME%" }
  }
}
