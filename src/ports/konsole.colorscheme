# %FULL% for Konsole. %NOTE%
# Generated by build.mjs from src/ports/konsole.colorscheme. Do not edit ports/konsole/.
# Copy into ~/.local/share/konsole/, then Settings > Edit Current Profile > Appearance.
#
# Colour 0 to 7 and their Intense pair are the same ANSI mapping kitty and Ghostty
# use. Konsole also wants a Faint variant, which Darkberry has no role for, so each
# one is mixed 40% toward the background.

[Background]
Color={ui.background}

[BackgroundFaint]
Color={mix(ui.background,ui.pane.tertiary,0.4)}

[BackgroundIntense]
Color={ui.pane.tertiary}

[Color0]
Color={ansi.0}

[Color0Faint]
Color={mix(ansi.0,ui.background,0.4)}

[Color0Intense]
Color={ansi.8}

[Color1]
Color={ansi.1}

[Color1Faint]
Color={mix(ansi.1,ui.background,0.4)}

[Color1Intense]
Color={ansi.9}

[Color2]
Color={ansi.2}

[Color2Faint]
Color={mix(ansi.2,ui.background,0.4)}

[Color2Intense]
Color={ansi.10}

[Color3]
Color={ansi.3}

[Color3Faint]
Color={mix(ansi.3,ui.background,0.4)}

[Color3Intense]
Color={ansi.11}

[Color4]
Color={ansi.4}

[Color4Faint]
Color={mix(ansi.4,ui.background,0.4)}

[Color4Intense]
Color={ansi.12}

[Color5]
Color={ansi.5}

[Color5Faint]
Color={mix(ansi.5,ui.background,0.4)}

[Color5Intense]
Color={ansi.13}

[Color6]
Color={ansi.6}

[Color6Faint]
Color={mix(ansi.6,ui.background,0.4)}

[Color6Intense]
Color={ansi.14}

[Color7]
Color={ansi.7}

[Color7Faint]
Color={mix(ansi.7,ui.background,0.4)}

[Color7Intense]
Color={ansi.15}

[Foreground]
Color={ui.text}

[ForegroundFaint]
Color={ui.text.muted}

[ForegroundIntense]
Color={ui.accent}

[General]
Description=%FULL%
Opacity=1
Wallpaper=
