# %FULL% for KDE Plasma. %NOTE%
# Generated by build.mjs from src/ports/kde.colors. Do not edit ports/kde/.
# Copy into ~/.local/share/color-schemes/, then System Settings > Colors.
#
# KDE splits chrome from content: Window is dialogs and panels, View is the text
# and list areas inside them. Darkberry follows its own split, so Window sits on
# the sidebar colour and View on the background every editor already uses.

[ColorEffects:Disabled]
Color={overlay0}
ColorAmount=0
ColorEffect=0
ContrastAmount=0.65
ContrastEffect=1
IntensityAmount=0.1
IntensityEffect=2

[ColorEffects:Inactive]
ChangeSelectionColor=true
Color={overlay1}
ColorAmount=0.025
ColorEffect=2
ContrastAmount=0.1
ContrastEffect=2
Enable=false
IntensityAmount=0
IntensityEffect=0

[Colors:Button]
BackgroundAlternate={surface1}
BackgroundNormal={surface0}
DecorationFocus={ui.accent}
DecorationHover={ui.focus}
ForegroundActive={ui.accent}
ForegroundInactive={ui.text.muted}
ForegroundLink={ui.link}
ForegroundNegative={ui.error}
ForegroundNeutral={ui.warning}
ForegroundNormal={ui.text}
ForegroundPositive={ui.success}
ForegroundVisited={plum}

[Colors:Complementary]
BackgroundAlternate={surface0}
BackgroundNormal={ui.pane.tertiary}
DecorationFocus={ui.accent}
DecorationHover={ui.focus}
ForegroundActive={ui.accent}
ForegroundInactive={ui.text.muted}
ForegroundLink={ui.link}
ForegroundNegative={ui.error}
ForegroundNeutral={ui.warning}
ForegroundNormal={ui.text}
ForegroundPositive={ui.success}
ForegroundVisited={plum}

[Colors:Header]
BackgroundAlternate={ui.background}
BackgroundNormal={ui.pane.secondary}
DecorationFocus={ui.accent}
DecorationHover={ui.focus}
ForegroundActive={ui.accent}
ForegroundInactive={ui.text.muted}
ForegroundLink={ui.link}
ForegroundNegative={ui.error}
ForegroundNeutral={ui.warning}
ForegroundNormal={ui.text}
ForegroundPositive={ui.success}
ForegroundVisited={plum}

[Colors:Header][Inactive]
BackgroundAlternate={ui.pane.secondary}
BackgroundNormal={ui.pane.tertiary}
DecorationFocus={ui.accent}
DecorationHover={ui.focus}
ForegroundActive={ui.accent}
ForegroundInactive={ui.text.muted}
ForegroundLink={ui.link}
ForegroundNegative={ui.error}
ForegroundNeutral={ui.warning}
ForegroundNormal={ui.text.muted}
ForegroundPositive={ui.success}
ForegroundVisited={plum}

[Colors:Selection]
BackgroundAlternate={surface2}
BackgroundNormal={ui.fill}
DecorationFocus={ui.accent}
DecorationHover={ui.focus}
ForegroundActive={ui.on.fill}
ForegroundInactive={ui.text.muted}
ForegroundLink={ui.link}
ForegroundNegative={ui.error}
ForegroundNeutral={ui.warning}
ForegroundNormal={ui.on.fill}
ForegroundPositive={ui.success}
ForegroundVisited={plum}

[Colors:Tooltip]
BackgroundAlternate={ui.pane.tertiary}
BackgroundNormal={ui.pane.secondary}
DecorationFocus={ui.accent}
DecorationHover={ui.focus}
ForegroundActive={ui.accent}
ForegroundInactive={ui.text.muted}
ForegroundLink={ui.link}
ForegroundNegative={ui.error}
ForegroundNeutral={ui.warning}
ForegroundNormal={ui.text}
ForegroundPositive={ui.success}
ForegroundVisited={plum}

[Colors:View]
BackgroundAlternate={surface0}
BackgroundNormal={ui.background}
DecorationFocus={ui.accent}
DecorationHover={ui.focus}
ForegroundActive={ui.accent}
ForegroundInactive={ui.text.muted}
ForegroundLink={ui.link}
ForegroundNegative={ui.error}
ForegroundNeutral={ui.warning}
ForegroundNormal={ui.text}
ForegroundPositive={ui.success}
ForegroundVisited={plum}

[Colors:Window]
BackgroundAlternate={surface0}
BackgroundNormal={ui.pane.secondary}
DecorationFocus={ui.accent}
DecorationHover={ui.focus}
ForegroundActive={ui.accent}
ForegroundInactive={ui.text.muted}
ForegroundLink={ui.link}
ForegroundNegative={ui.error}
ForegroundNeutral={ui.warning}
ForegroundNormal={ui.text}
ForegroundPositive={ui.success}
ForegroundVisited={plum}

[General]
ColorScheme=%FULL%
Name=%FULL%
shadeSortColumn=true

[WM]
activeBackground={ui.pane.secondary}
activeBlend={ui.text}
activeForeground={ui.text}
inactiveBackground={ui.pane.tertiary}
inactiveBlend={ui.text.muted}
inactiveForeground={ui.text.muted}
